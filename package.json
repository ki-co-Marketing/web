{
  "name": "arcana",
  "version": "0.1.0",
  "private": true,
  "description": "Arcana — a gamified path into tarot, astrology, and the mystic arts.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "screenshots": "playwright test e2e/screenshots.spec.ts",
    "fetch:cards": "node scripts/fetch-tarot-images.mjs",
    "generate:cards-fallback": "node scripts/generate-card-svgs.mjs"
  },
  "dependencies": {
    "@fontsource-variable/cormorant-garamond": "^5.2.6",
    "@fontsource-variable/inter": "^5.2.8",
    "next": "16.2.10",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.9.0",
    "vitest": "^4.1.10"
  }
}
